{
  "name": "kila-wonderland-tailwindcss",
  "version": "1.0.0",
  "description": "Kila Wonderland Modern E-Commerce Catalog with Tailwind CSS v4",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i style.css -o dist/output.css --watch",
    "build:css": "npx @tailwindcss/cli -i style.css -o dist/output.css --minify",
    "serve": "node local-server.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
